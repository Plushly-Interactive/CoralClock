{
  "manifest_version": 3,
  "name": "BiteGuard",
  "version": "0.1.0",
  "description": "Block websites after a time limit.",

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "BiteGuard"
  },

  "permissions": ["storage", "alarms", "tabs"]
}
