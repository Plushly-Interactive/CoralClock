{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "icons": {
    "16": "resources/icons/brand/icon16.png",
    "48": "resources/icons/brand/icon48.png",
    "128": "resources/icons/brand/icon128.png"
  },

  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "CoralClock",
    "default_icon": {
      "16": "resources/icons/brand/icon16.png",
      "48": "resources/icons/brand/icon48.png",
      "128": "resources/icons/brand/icon128.png"
    }
  },

  "permissions": ["storage", "alarms", "tabs", "webNavigation", "declarativeNetRequestWithHostAccess", "idle", "favicon", "notifications"],
  "optional_host_permissions": ["<all_urls>"],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "__MSG_command_openPopup__"
    }
  },

  "options_page": "src/pages/settings/settings.html",

  "web_accessible_resources": [{
    "resources": ["src/pages/blocked/blocked.html", "_locales/*/messages.json"],
    "matches": ["<all_urls>"]
  }]
}
