{
  "manifest_version": 3,
  "name": "Reef - Screen Time & Website Blocker",
  "version": "1.0.0",
  "description": "Block websites after a time limit.",

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "icons": {
    "16": "resources/icons/reef-icon-square-16px.png",
    "48": "resources/icons/reef-icon-square-48px.png",
    "128": "resources/icons/reef-icon-square-128px.png"
  },

  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "Reef",
    "default_icon": {
      "16": "resources/icons/reef-icon-square-16px.png",
      "48": "resources/icons/reef-icon-square-48px.png",
      "128": "resources/icons/reef-icon-square-128px.png"
    }
  },

  "permissions": ["storage", "alarms", "tabs", "webNavigation", "declarativeNetRequest", "idle", "favicon", "notifications"],
  "host_permissions": ["<all_urls>"],

  "options_page": "src/pages/settings/settings.html",

  "web_accessible_resources": [{
    "resources": ["src/pages/blocked/blocked.html"],
    "matches": ["<all_urls>"]
  }]
}
