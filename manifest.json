{
  "manifest_version": 3,
  "name": "Reef - Screen Time & Website Blocker",
  "version": "1.0.0",
  "description": "Track time on every website and automatically block sites once your hourly, daily, or weekly limit is reached.",

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "icons": {
    "16": "resources/icons/png/icon16.png",
    "48": "resources/icons/png/icon48.png",
    "128": "resources/icons/png/icon128.png"
  },

  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "Reef",
    "default_icon": {
      "16": "resources/icons/png/icon16.png",
      "48": "resources/icons/png/icon48.png",
      "128": "resources/icons/png/icon128.png"
    }
  },

  "permissions": ["storage", "alarms", "tabs", "webNavigation", "declarativeNetRequestWithHostAccess", "idle", "favicon", "notifications"],
  "optional_host_permissions": ["<all_urls>"],

  "options_page": "src/pages/settings/settings.html",

  "web_accessible_resources": [{
    "resources": ["src/pages/blocked/blocked.html"],
    "matches": ["<all_urls>"]
  }]
}
